# Projet Supabase dédié à l'app BVB (créer un nouveau projet, région Europe).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secret de signature des cookies de session (>= 32 caractères aléatoires).
# Générer avec : openssl rand -base64 48
SESSION_SECRET=

# Notifications push (Web Push API). Générer une paire avec :
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY et NEXT_PUBLIC_VAPID_PUBLIC_KEY doivent avoir la même valeur.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Jeton requis pour créer le premier compte admin via /installation
# (générer avec : openssl rand -hex 16). Change de valeur une fois le
# premier admin créé pour éviter toute réutilisation.
SETUP_TOKEN=
